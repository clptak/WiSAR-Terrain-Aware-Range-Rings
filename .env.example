# Optional CCSO-mode CalTopo push. Copy to .env and fill in to enable it.
# Leave blank to boot without that path; other teams can still enter their
# own CalTopo credentials in the UI. Never commit .env.
CALTOPO_ACCOUNT_ID=
CALTOPO_CREDENTIAL_ID=
CALTOPO_CREDENTIAL_KEY=

# CloudTAK DataSync push. The API URL is how this container reaches CloudTAK
# on a shared Docker network. The token is a CloudTAK user API token (etl.…).
# Either value can instead be saved from the TAK connection dialog, which
# stores them in the wisar-tak-config volume and takes precedence. Never
# commit a real token.
CLOUDTAK_API_URL=http://api:5000
CLOUDTAK_API_TOKEN=
