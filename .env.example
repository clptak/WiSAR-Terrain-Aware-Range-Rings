# Optional CCSO-mode CalTopo push. Copy to .env and fill in to enable it.
# Leave blank to boot without that path; other teams can still enter their
# own CalTopo credentials in the UI. Never commit .env.
CALTOPO_ACCOUNT_ID=
CALTOPO_CREDENTIAL_ID=
CALTOPO_CREDENTIAL_KEY=

# CloudTAK, used only to verify callers of /api/v1: WiSAR forwards the
# caller's bearer token to GET {CLOUDTAK_API_URL}/api/login. This is how the
# container reaches CloudTAK on the shared Docker network.
CLOUDTAK_API_URL=http://api:5000

# Several CloudTAK deployments sharing this WiSAR. Comma-separated
# `<CloudTAK web origin>=<CloudTAK API base URL>`, or just the origin when the
# API is on the same origin. The browser's Origin picks which CloudTAK checks
# the token; other origins are refused. The first entry is used for requests
# without an Origin (curl, smoke test). Every origin listed here is also
# allowed for CORS. When set, CLOUDTAK_API_URL is not used.
# e.g. https://map.a.org=http://cloudtak-api:5000,https://map.b.org
WISAR_CLOUDTAK_INSTANCES=

# Browser origins allowed to call /api/v1 (comma-separated), e.g. the
# CloudTAK web URL. Empty = no cross-origin browser access.
WISAR_CORS_ORIGINS=

# Hours a finished job's outputs are kept before automatic deletion.
WISAR_JOB_TTL_HOURS=72

# Most v1 jobs that may wait in the queue before new ones get 503.
WISAR_MAX_QUEUED=10

# cloudtak = verify every /api call with CloudTAK. none = no authentication,
# for local testing only; never on a reachable host.
WISAR_AUTH=cloudtak
